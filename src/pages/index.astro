---
import { apps, developer } from '../data/apps';
import '../styles/global.css';

const featuredApp = apps.find((app) => app.featured) ?? apps[0];
const otherApps = apps.filter((app) => app.id !== featuredApp.id);
const categories = [...new Set(apps.map((app) => app.category))];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="绪海 罗开发的移动 App 作品集，包含专注、测距、无障碍、英语学习和夜视工具。" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f3ea" />
    <title>{developer.name} · App 作品集</title>
  </head>
  <body>
    <main class="site-shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">Independent iOS Apps</p>
          <h1 id="hero-title">把实用想法做成简洁、专注的移动 App。</h1>
          <p class="hero__intro">
            这里展示 {developer.name} 开发的全部 App。数据已打包在本地，页面无需依赖远程接口即可渲染。
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="#apps">查看 App</a>
            <a class="button button--ghost" href={developer.appStoreUrl} target="_blank" rel="noreferrer">App Store 主页</a>
          </div>
        </div>

        <aside class="hero-card" aria-label="精选 App">
          <div class="phone-frame">
            <div class="phone-frame__status"></div>
            <div class="phone-frame__app" style={`--accent: ${featuredApp.accent}`}>
              <span class="app-icon app-icon--large">{featuredApp.icon}</span>
              <p>最新发布</p>
              <h2>{featuredApp.name}</h2>
              <span>{featuredApp.subtitle}</span>
            </div>
          </div>
        </aside>
      </section>

      <section class="stats" aria-label="作品概览">
        <div>
          <strong>{apps.length}</strong>
          <span>款 App</span>
        </div>
        <div>
          <strong>{categories.length}</strong>
          <span>个方向</span>
        </div>
        <div>
          <strong>iPhone</strong>
          <span>移动优先</span>
        </div>
      </section>

      <section id="apps" class="apps-section" aria-labelledby="apps-title">
        <div class="section-heading">
          <p class="eyebrow">All Apps</p>
          <h2 id="apps-title">全部作品</h2>
          <p>从专注习惯、无障碍辅助到深度传感器工具，每款 App 都围绕一个清晰问题展开。</p>
        </div>

        <div class="app-grid">
          {[featuredApp, ...otherApps].map((app) => (
            <article class:list={["app-card", { "app-card--featured": app.featured }]} style={`--accent: ${app.accent}`}>
              <div class="app-card__top">
                <span class="app-icon">{app.icon}</span>
                <span class="category">{app.category}</span>
              </div>
              <h3>{app.name}</h3>
              <p class="subtitle">{app.subtitle}</p>
              <p class="description">{app.description}</p>
              <div class="platforms" aria-label={`${app.name} 支持平台`}>
                {app.platforms.map((platform) => <span>{platform}</span>)}
              </div>
              <div class="tags" aria-label={`${app.name} 标签`}>
                {app.tags.map((tag) => <span>#{tag}</span>)}
              </div>
              <a class="store-link" href={app.storeUrl} target="_blank" rel="noreferrer" aria-label={`在 App Store 查看 ${app.name}`}>
                App Store
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="contact" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title">想了解更多？</h2>
          <p>欢迎通过邮件反馈 App 体验，或在 App Store 查看完整开发者页面。</p>
        </div>
        <div class="contact__actions">
          <a class="button button--primary" href={`mailto:${developer.email}`}>发送邮件</a>
          <a class="button button--ghost" href={developer.appStoreUrl} target="_blank" rel="noreferrer">打开 App Store</a>
        </div>
      </section>
    </main>
  </body>
</html>
