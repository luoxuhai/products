---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { apps, contributionProjects, defaultLocale, developer, localeMeta, locales, openSourceProjects, ui, type Locale } from '../data/apps';
import '../styles/global.css';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
const t = ui[locale];
const developerName = developer.name[locale];
const appStoreCountryCodes = {
  "zh-cn": "cn",
  "zh-tw": "tw",
  en: "us",
  ja: "jp",
} satisfies Record<Locale, string>;
const buildAppStoreUrl = (appStoreId: string) =>
  `https://apps.apple.com/${appStoreCountryCodes[locale]}/app/id${appStoreId}`;
const localizedApps = apps.map((app) => ({
  ...app,
  ...app.content[locale],
  storeUrl: buildAppStoreUrl(app.appStoreId),
}));
const localizedOpenSourceProjects = openSourceProjects.map((project) => ({
  ...project,
  ...project.content[locale],
}));
const localizedContributionProjects = contributionProjects.map((project) => ({
  ...project,
  ...project.content[locale],
}));
const featuredApp = localizedApps.find((app) => app.featured) ?? localizedApps[0];
const otherApps = localizedApps.filter((app) => app.id !== featuredApp.id);
const maintenanceDays = (new Date().getFullYear() - 2020) * 365;
const pageTitle = `${developerName} · ${t.pageTitle}`;
const independentExperienceYears = new Date().getFullYear() - 2020;
const getOfficialLocalePath = (targetLocale: Locale) => getRelativeLocaleUrl(targetLocale);
const canonicalPath = getOfficialLocalePath(locale);
const buildHeroIntro = () => `${independentExperienceYears}${t.heroIntroExperienceSuffix}`;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={t.metaDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f5f7" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script is:inline>
      (() => {
        const lightThemeColor = "#f5f5f7";
        const darkThemeColor = "#000000";
        const getStoredTheme = () => {
          try {
            const storedTheme = localStorage.getItem("theme");
            return storedTheme === "dark" || storedTheme === "light" ? storedTheme : null;
          } catch {
            return null;
          }
        };
        const theme =
          getStoredTheme() ?? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? darkThemeColor : lightThemeColor);
      })();
    </script>
    <link rel="canonical" href={canonicalPath} />
    {locales.map((availableLocale) => (
      <link rel="alternate" hreflang={localeMeta[availableLocale].htmlLang} href={getOfficialLocalePath(availableLocale)} />
    ))}
    <link rel="alternate" hreflang="x-default" href="/" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="site-shell">
      <div class="top-controls">
        <nav class="nav-links" aria-label="Main navigation">
          <a href="#apps" class="nav-link">{t.appsTitle}</a>
          <a href="#open-source" class="nav-link">{t.openSourceTitle}</a>
          <a href="#contributions" class="nav-link">{t.contributionsTitle}</a>
        </nav>
        <div class="controls-right">
          <div class="language-switcher">
            <label class="visually-hidden" for="language-select">{t.languageNavLabel}</label>
            <select
              id="language-select"
              class="language-switcher__select"
              aria-label={t.languageNavLabel}
              onchange="window.location.href = this.value"
            >
              {locales.map((availableLocale) => (
                <option
                  value={getOfficialLocalePath(availableLocale)}
                  selected={availableLocale === locale}
                  lang={localeMeta[availableLocale].htmlLang}
                >
                  {localeMeta[availableLocale].nativeName}
                </option>
              ))}
            </select>
          </div>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label={t.themeToggleLabel} aria-pressed="false">
          <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M21 14.6A8.83 8.83 0 0 1 9.4 3a.75.75 0 0 0-.78-1.04A10.33 10.33 0 1 0 22.04 15.38a.75.75 0 0 0-1.04-.78ZM11.67 20.5a8.83 8.83 0 0 1-5.9-15.4 10.33 10.33 0 0 0 13.12 13.12 8.8 8.8 0 0 1-7.22 2.28Z" />
          </svg>
          <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 6.25A5.75 5.75 0 1 0 12 17.75 5.75 5.75 0 0 0 12 6.25Zm0 10A4.25 4.25 0 1 1 12 7.75a4.25 4.25 0 0 1 0 8.5ZM12 1.75a.75.75 0 0 1 .75.75v1.25a.75.75 0 0 1-1.5 0V2.5a.75.75 0 0 1 .75-.75Zm0 17.75a.75.75 0 0 1 .75.75v1.25a.75.75 0 0 1-1.5 0v-1.25a.75.75 0 0 1 .75-.75ZM22.25 12a.75.75 0 0 1-.75.75h-1.25a.75.75 0 0 1 0-1.5h1.25a.75.75 0 0 1 .75.75ZM4.5 12a.75.75 0 0 1-.75.75H2.5a.75.75 0 0 1 0-1.5h1.25A.75.75 0 0 1 4.5 12Zm14.72-7.22a.75.75 0 0 1 0 1.06l-.88.88a.75.75 0 1 1-1.06-1.06l.88-.88a.75.75 0 0 1 1.06 0ZM6.72 17.28a.75.75 0 0 1 0 1.06l-.88.88a.75.75 0 0 1-1.06-1.06l.88-.88a.75.75 0 0 1 1.06 0Zm12.5 1.94a.75.75 0 0 1-1.06 0l-.88-.88a.75.75 0 0 1 1.06-1.06l.88.88a.75.75 0 0 1 0 1.06ZM6.72 6.72a.75.75 0 0 1-1.06 0l-.88-.88a.75.75 0 0 1 1.06-1.06l.88.88a.75.75 0 0 1 0 1.06Z" />
          </svg>
        </button>
        </div>
      </div>

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">{t.heroEyebrow}</p>
          <h1 id="hero-title">{t.heroTitle}</h1>
          <p class="hero__intro">{buildHeroIntro()}</p>
          <div class="hero__actions">
            <a class="button button--primary" href="#apps">{t.viewApps}</a>
            <a class="button button--ghost" href={developer.appStoreUrl} target="_blank" rel="noreferrer">{t.appStoreHome}</a>
          </div>
        </div>

        <aside class="hero-card" aria-label={t.appConstellationLabel}>
          <div class="app-constellation">
            {localizedApps.map((app, index) => (
              <div class={`constellation-orbit constellation-orbit--${index + 1}`} style={`--accent: ${app.accent}`}>
                <a
                  class={`constellation-icon constellation-icon--${index + 1}`}
                  href={app.storeUrl}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`${t.appStoreAriaPrefix} ${app.name}`}
                >
                  <img
                    class="app-icon"
                    src={app.iconUrl}
                    alt=""
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <span class="constellation-icon__name">{app.name}</span>
                </a>
              </div>
            ))}
            <div class="constellation-glow constellation-glow--one" aria-hidden="true"></div>
            <div class="constellation-glow constellation-glow--two" aria-hidden="true"></div>
            <div class="constellation-ring constellation-ring--one" aria-hidden="true"></div>
            <div class="constellation-ring constellation-ring--two" aria-hidden="true"></div>
          </div>
        </aside>
      </section>

      <section class="stats" aria-label={t.overviewLabel}>
        <div>
          <strong>{apps.length}{t.publishedProductsUnit}</strong>
          <span>{t.publishedProductsLabel}</span>
        </div>
        <div>
          <strong>{t.originalValue}</strong>
          <span>{t.originalLabel}</span>
        </div>
        <div>
          <strong>{t.nativeExperienceValue}</strong>
          <span>{t.nativeExperienceLabel}</span>
        </div>
        <div>
          <strong>{maintenanceDays}{t.daysUnit}</strong>
          <span>{t.maintenanceLabel}</span>
        </div>
      </section>

      <section id="apps" class="apps-section" aria-labelledby="apps-title">
        <div class="section-heading">
          <p class="eyebrow">{t.appsEyebrow}</p>
          <h2 id="apps-title">{t.appsTitle}</h2>
          <p>{t.appsIntro}</p>
        </div>

        <div class="app-grid">
          {[featuredApp, ...otherApps].map((app) => (
            <article class:list={["app-card", { "app-card--featured": app.featured }]} style={`--accent: ${app.accent}`}>
              <div class="app-card__top">
                <img
                  class="app-icon"
                  src={app.iconUrl}
                  alt={`${app.name} App Icon`}
                  loading="lazy"
                  decoding="async"
                />
                <span class="category">{app.category}</span>
              </div>
              <h3>{app.name}</h3>
              <p class="subtitle">{app.subtitle}</p>
              <p class="description">{app.description}</p>
              <div class="platforms" aria-label={`${app.name} ${t.platformsLabel}`}>
                {app.platforms.map((platform) => <span>{platform}</span>)}
              </div>
              <div class="tags" aria-label={`${app.name} ${t.tagsLabel}`}>
                {app.tags.map((tag) => <span>#{tag}</span>)}
              </div>
              <a class="store-link" href={app.storeUrl} target="_blank" rel="noreferrer" aria-label={`${t.appStoreAriaPrefix} ${app.name}`}>
                App Store
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section id="open-source" class="projects-section" aria-labelledby="open-source-title">
        <div class="section-heading">
          <p class="eyebrow">{t.openSourceEyebrow}</p>
          <h2 id="open-source-title">{t.openSourceTitle}</h2>
          <p>{t.openSourceIntro}</p>
        </div>

        <div class="project-grid project-grid--featured">
          {localizedOpenSourceProjects.map((project) => (
            <article class="project-card" style={`--accent: ${project.accent}`}>
              <div class="project-card__top">
                <span class="project-card__repo">{project.repository}</span>
                <span class="project-card__language">{project.language}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <div class="tags" aria-label={`${project.name} ${t.tagsLabel}`}>
                {project.tags.map((tag) => <span>#{tag}</span>)}
              </div>
              <a class="project-link" href={project.url} target="_blank" rel="noreferrer" aria-label={`${t.projectRepoLabel}: ${project.repository}`}>
                GitHub
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section id="contributions" class="projects-section projects-section--compact" aria-labelledby="contributions-title">
        <div class="section-heading">
          <p class="eyebrow">{t.contributionsEyebrow}</p>
          <h2 id="contributions-title">{t.contributionsTitle}</h2>
          <p>{t.contributionsIntro}</p>
        </div>

        <div class="project-grid project-grid--compact">
          {localizedContributionProjects.map((project) => (
            <article class="project-card project-card--compact" style={`--accent: ${project.accent}`}>
              <div class="project-card__top">
                <span class="project-card__repo">{project.repository}</span>
                <span class="project-card__language">{project.language}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <a class="project-link" href={project.url} target="_blank" rel="noreferrer" aria-label={`${t.projectRepoLabel}: ${project.repository}`}>
                GitHub
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <footer class="about" aria-labelledby="about-title">
        <div>
          <p class="eyebrow">{t.aboutEyebrow}</p>
          <h2 id="about-title">{t.aboutTitle}</h2>
          <p class="about__name">Luo Xuhai</p>
          <p class="about__title">{t.aboutDeveloperTitle}</p>
          <p class="about__experience">{independentExperienceYears}{t.aboutExperienceSuffix}</p>
          <p>{t.aboutText}</p>
        </div>
        <div class="about__links">
          <a class="button button--ghost button--with-icon" href={developer.githubUrl} target="_blank" rel="noreferrer" aria-label="GitHub">
            <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 2C6.48 2 2 6.58 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.98c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.07.36.32.68.94.68 1.9 0 1.38-.01 2.49-.01 2.83 0 .27.18.59.69.49A10.15 10.15 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" />
            </svg>
            <span>GitHub</span>
          </a>
          <a class="button button--ghost button--with-icon" href={developer.xUrl} target="_blank" rel="noreferrer" aria-label="X">
            <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M17.53 3h3.06l-6.69 7.65L21.77 21h-6.16l-4.82-6.3L5.27 21H2.21l7.15-8.18L1.82 3h6.31l4.36 5.76L17.53 3Zm-1.07 16.18h1.7L7.21 4.72H5.39l11.07 14.46Z" />
            </svg>
            <span>X</span>
          </a>
          <a class="button button--ghost button--with-icon" href={`mailto:${developer.email}`}>
            <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M4.5 5h15A2.5 2.5 0 0 1 22 7.5v9A2.5 2.5 0 0 1 19.5 19h-15A2.5 2.5 0 0 1 2 16.5v-9A2.5 2.5 0 0 1 4.5 5Zm0 2c-.13 0-.25.02-.36.07L12 12.18l7.86-5.11A.92.92 0 0 0 19.5 7h-15Zm15 10a.5.5 0 0 0 .5-.5V9.08l-7.45 4.84a1 1 0 0 1-1.1 0L4 9.08v7.42a.5.5 0 0 0 .5.5h15Z" />
            </svg>
            <span>{t.email}</span>
          </a>
        </div>
      </footer>
    </main>
    <script is:inline>
      (() => {
        const lightThemeColor = "#f5f5f7";
        const darkThemeColor = "#000000";
        const root = document.documentElement;
        const toggle = document.querySelector("[data-theme-toggle]");
        if (!toggle) {
          return;
        }

        const getStoredTheme = () => {
          try {
            const storedTheme = localStorage.getItem("theme");
            return storedTheme === "dark" || storedTheme === "light" ? storedTheme : null;
          } catch {
            return null;
          }
        };

        const setStoredTheme = (theme) => {
          try {
            localStorage.setItem("theme", theme);
          } catch {}
        };

        const setTheme = (theme) => {
          root.dataset.theme = theme;
          toggle.setAttribute("aria-pressed", String(theme === "dark"));
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", theme === "dark" ? darkThemeColor : lightThemeColor);
        };

        setTheme(root.dataset.theme === "dark" ? "dark" : "light");
        toggle.addEventListener("click", () => {
          const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
          setStoredTheme(nextTheme);
          setTheme(nextTheme);
        });

        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
          if (!getStoredTheme()) {
            setTheme(event.matches ? "dark" : "light");
          }
        });
      })();
    </script>
  </body>
</html>
