---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { apps, defaultLocale, developer, localeMeta, locales, ui, type Locale } from '../data/apps';
import '../styles/global.css';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
const t = ui[locale];
const developerName = developer.name[locale];
const localizedApps = apps.map((app) => ({ ...app, ...app.content[locale] }));
const featuredApp = localizedApps.find((app) => app.featured) ?? localizedApps[0];
const otherApps = localizedApps.filter((app) => app.id !== featuredApp.id);
const maintenanceDays = (new Date().getFullYear() - 2020) * 365;
const pageTitle = `${developerName} · ${t.pageTitle}`;
const getOfficialLocalePath = (targetLocale: Locale) => getRelativeLocaleUrl(targetLocale);
const canonicalPath = getOfficialLocalePath(locale);
const buildHeroIntro = () => {
  if (locale === 'ja') {
    return `${developerName}${t.heroIntroSuffix}`;
  }

  if (locale === 'en') {
    return `${t.heroIntroPrefix} ${developerName}. ${t.heroIntroSuffix}`;
  }

  return `${t.heroIntroPrefix}${developerName}${t.heroIntroSuffix}`;
};
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={t.metaDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f3ea" />
    <link rel="canonical" href={canonicalPath} />
    {locales.map((availableLocale) => (
      <link rel="alternate" hreflang={localeMeta[availableLocale].htmlLang} href={getOfficialLocalePath(availableLocale)} />
    ))}
    <link rel="alternate" hreflang="x-default" href="/" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="site-shell">
      <nav class="language-switcher" aria-label={t.languageNavLabel}>
        {locales.map((availableLocale) => (
          <a
            class:list={["language-switcher__link", { "language-switcher__link--active": availableLocale === locale }]}
            href={getOfficialLocalePath(availableLocale)}
            lang={localeMeta[availableLocale].htmlLang}
            aria-current={availableLocale === locale ? 'page' : undefined}
          >
            {localeMeta[availableLocale].nativeName}
          </a>
        ))}
      </nav>

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">{t.heroEyebrow}</p>
          <h1 id="hero-title">{t.heroTitle}</h1>
          <p class="hero__intro">{buildHeroIntro()}</p>
          <div class="hero__actions">
            <a class="button button--primary" href="#apps">{t.viewApps}</a>
            <a class="button button--ghost" href={developer.appStoreUrl} target="_blank" rel="noreferrer">{t.appStoreHome}</a>
          </div>
        </div>

        <aside class="hero-card" aria-label={t.appConstellationLabel}>
          <div class="app-constellation" aria-hidden="true">
            {localizedApps.map((app, index) => (
              <div class={`constellation-icon constellation-icon--${index + 1}`} style={`--accent: ${app.accent}`}>
                <img
                  class="app-icon"
                  src={app.iconUrl}
                  alt=""
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            ))}
            <div class="constellation-glow constellation-glow--one"></div>
            <div class="constellation-glow constellation-glow--two"></div>
            <div class="constellation-ring constellation-ring--one"></div>
            <div class="constellation-ring constellation-ring--two"></div>
          </div>
        </aside>
      </section>

      <section class="stats" aria-label={t.overviewLabel}>
        <div>
          <strong>{apps.length}{t.publishedProductsUnit}</strong>
          <span>{t.publishedProductsLabel}</span>
        </div>
        <div>
          <strong>{t.originalValue}</strong>
          <span>{t.originalLabel}</span>
        </div>
        <div>
          <strong>{t.nativeExperienceValue}</strong>
          <span>{t.nativeExperienceLabel}</span>
        </div>
        <div>
          <strong>{maintenanceDays}{t.daysUnit}</strong>
          <span>{t.maintenanceLabel}</span>
        </div>
      </section>

      <section id="apps" class="apps-section" aria-labelledby="apps-title">
        <div class="section-heading">
          <p class="eyebrow">{t.appsEyebrow}</p>
          <h2 id="apps-title">{t.appsTitle}</h2>
          <p>{t.appsIntro}</p>
        </div>

        <div class="app-grid">
          {[featuredApp, ...otherApps].map((app) => (
            <article class:list={["app-card", { "app-card--featured": app.featured }]} style={`--accent: ${app.accent}`}>
              <div class="app-card__top">
                <img
                  class="app-icon"
                  src={app.iconUrl}
                  alt={`${app.name} App Icon`}
                  loading="lazy"
                  decoding="async"
                />
                <span class="category">{app.category}</span>
              </div>
              <h3>{app.name}</h3>
              <p class="subtitle">{app.subtitle}</p>
              <p class="description">{app.description}</p>
              <div class="platforms" aria-label={`${app.name} ${t.platformsLabel}`}>
                {app.platforms.map((platform) => <span>{platform}</span>)}
              </div>
              <div class="tags" aria-label={`${app.name} ${t.tagsLabel}`}>
                {app.tags.map((tag) => <span>#{tag}</span>)}
              </div>
              <a class="store-link" href={app.storeUrl} target="_blank" rel="noreferrer" aria-label={`${t.appStoreAriaPrefix} ${app.name}`}>
                App Store
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <footer class="about" aria-labelledby="about-title">
        <div>
          <p class="eyebrow">{t.aboutEyebrow}</p>
          <h2 id="about-title">{t.aboutTitle}</h2>
          <p>{t.aboutText}</p>
        </div>
        <div class="about__links">
          <a class="button button--primary" href={developer.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
          <a class="button button--ghost" href={developer.xUrl} target="_blank" rel="noreferrer">X</a>
          <a class="button button--ghost" href={`mailto:${developer.email}`}>{t.email}</a>
        </div>
      </footer>
    </main>
  </body>
</html>
